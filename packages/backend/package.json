{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:pretty": "wrangler dev | pino-pretty",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate-local": "wrangler d1 migrations apply webmarks --local",
    "db:migrate-remote": "wrangler d1 migrations apply webmarks --remote",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
