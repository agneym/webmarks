{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-27",
  "compatibility_flags": ["nodejs_compat"],
  // Non-secret config. Local values in .dev.vars override these during
  // `wrangler dev`. Secrets (BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET) are set
  // with `wrangler secret put`.
  "vars": {
    "BETTER_AUTH_URL": "https://backend.quickread.workers.dev",
    "GOOGLE_CLIENT_ID": "1038763736810-i3lrufrvdtjj993jl8i07288rr8u6e99.apps.googleusercontent.com",
    "OWNER_EMAIL": "agney.menons@gmail.com",
    "WEB_APP_URL": "https://agney.dev",
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "webmarks",
      "database_name": "webmarks",
      "database_id": "8c7071c0-ad83-460d-ad59-4749ba156aeb",
      "migrations_dir": "./drizzle",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "BOOKMARK_QUEUE",
        "queue": "bookmark-metadata-queue",
      },
    ],
    "consumers": [
      {
        "queue": "bookmark-metadata-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
      },
    ],
  },
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
